# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitees el .env real — ya está (o debería estar) en .gitignore.

# --- Base de datos (TiDB Cloud / MySQL) ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Autenticación ---
SECRET_KEY=

# --- Push notifications (VAPID) ---
VAPID_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Sentry (monitoreo de errores) ---
# Déjalo vacío en desarrollo local si no quieres mandar eventos a Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.2

# --- Reporte semanal automático por correo ---
# Requiere que MS_CLIENT_ID_PERSONAL / MS_CLIENT_SECRET_PERSONAL /
# MS_REFRESH_TOKEN (usados para OneDrive) tengan también el permiso
# Mail.Send en Graph — ver docstring de onedrive_service.enviar_correo().
REPORTE_SEMANAL_HABILITADO=0
REPORTE_SEMANAL_DESTINATARIOS=
REPORTE_SEMANAL_DIA=0
REPORTE_SEMANAL_HORA=8
